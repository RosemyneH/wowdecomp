if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(WOWDECOMP_LINUX 1)
else ()
    set(WOWDECOMP_LINUX 0)
endif ()

if (CMAKE_SYSTEM_NAME STREQUAL "Android")
    set(WOWDECOMP_ANDROID 1)
else ()
    set(WOWDECOMP_ANDROID 0)
endif ()

if (APPLE)
    set(WOWDECOMP_APPLE 1)
else ()
    set(WOWDECOMP_APPLE 0)
endif ()

if (WOWDECOMP_LINUX OR WOWDECOMP_APPLE OR WOWDECOMP_ANDROID)
    set(WOWDECOMP_UNIX 1)
else ()
    set(WOWDECOMP_UNIX 0)
endif ()

set(_wowdecomp_apple_arch "${CMAKE_OSX_ARCHITECTURES}")
if (NOT _wowdecomp_apple_arch)
    set(_wowdecomp_apple_arch "${CMAKE_SYSTEM_PROCESSOR}")
endif ()
if (WOWDECOMP_APPLE AND _wowdecomp_apple_arch MATCHES "arm64|aarch64")
    set(WOWDECOMP_APPLE_SILICON 1)
    add_compile_definitions(WOWDECOMP_APPLE_SILICON=1)
else ()
    set(WOWDECOMP_APPLE_SILICON 0)
endif ()

if (WIN32 AND CMAKE_SYSTEM_PROCESSOR MATCHES "ARM64|aarch64")
    set(WOWDECOMP_WIN_ARM64 1)
    add_compile_definitions(WOWDECOMP_WIN_ARM64=1)
else ()
    set(WOWDECOMP_WIN_ARM64 0)
endif ()

function(wowdecomp_is_linux out_var)
    set(${out_var} ${WOWDECOMP_LINUX} PARENT_SCOPE)
endfunction()

function(wowdecomp_is_apple out_var)
    set(${out_var} ${WOWDECOMP_APPLE} PARENT_SCOPE)
endfunction()

function(wowdecomp_is_unix out_var)
    set(${out_var} ${WOWDECOMP_UNIX} PARENT_SCOPE)
endfunction()

macro(wowdecomp_filter_windows_sources list_var)
    if (NOT WIN32)
        list(FILTER ${list_var} EXCLUDE REGEX "/(Win32|Win64|Windows)/")
    endif ()
endmacro()

macro(wowdecomp_filter_android_host_sources list_var)
    if (WOWDECOMP_ANDROID)
        list(FILTER ${list_var} EXCLUDE REGEX "/WaylandEmbed\\.cpp$|/protocol/")
    endif ()
endmacro()

macro(wowdecomp_filter_platform_sources list_var)
    wowdecomp_filter_windows_sources(${list_var})
    if (WIN32)
        list(FILTER ${list_var} EXCLUDE REGEX "/(Linux|Darwin)/")
    elseif (WOWDECOMP_APPLE)
        list(FILTER ${list_var} EXCLUDE REGEX "/Linux/")
    else ()
        list(FILTER ${list_var} EXCLUDE REGEX "/Darwin/")
    endif ()
    wowdecomp_filter_android_host_sources(${list_var})
endmacro()

macro(wowdecomp_filter_platform_sources_apple_uses_linux list_var)
    wowdecomp_filter_windows_sources(${list_var})
    if (WIN32)
        list(FILTER ${list_var} EXCLUDE REGEX "/(Linux|Darwin)/")
    else ()
        list(FILTER ${list_var} EXCLUDE REGEX "/Darwin/")
    endif ()
    wowdecomp_filter_android_host_sources(${list_var})
endmacro()

function(wowdecomp_unix_output_dir out_var)
    if (WOWDECOMP_APPLE)
        set(${out_var} ${CMAKE_SOURCE_DIR}/bin/Mac PARENT_SCOPE)
    elseif (WOWDECOMP_ANDROID)
        set(${out_var} ${CMAKE_SOURCE_DIR}/bin/Android PARENT_SCOPE)
    elseif (WOWDECOMP_LINUX)
        set(${out_var} ${CMAKE_SOURCE_DIR}/bin/Linux PARENT_SCOPE)
    else ()
        set(${out_var} ${CMAKE_SOURCE_DIR}/bin/Win PARENT_SCOPE)
    endif ()
endfunction()
