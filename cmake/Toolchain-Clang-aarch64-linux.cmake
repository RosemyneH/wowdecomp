# ʕ •ᴥ•ʔ✿ Clang cross toolchain for aarch64 Linux: Arch cross-gcc sysroot for libc, ALARM sysroot for libraries ✿ ʕ •ᴥ•ʔ
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if (NOT WOWDECOMP_AARCH64_SYSROOT)
    set(WOWDECOMP_AARCH64_SYSROOT $ENV{WOWDECOMP_AARCH64_SYSROOT})
endif ()
if (NOT WOWDECOMP_AARCH64_SYSROOT)
    set(WOWDECOMP_AARCH64_SYSROOT /opt/sysroot-aarch64)
endif ()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES WOWDECOMP_AARCH64_SYSROOT)

# ʕ ◕ᴥ◕ ʔ✿ lld/GNU ld only link cleanly against the cross-gcc sysroot; ALARM provides SDL/Vulkan/ALSA ✿ ʕ ◕ᴥ◕ ʔ
set(CMAKE_SYSROOT /usr/aarch64-linux-gnu)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_LINKER_TYPE LLD)

set(CMAKE_FIND_ROOT_PATH ${WOWDECOMP_AARCH64_SYSROOT} /usr/aarch64-linux-gnu)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(ENV{PKG_CONFIG_SYSROOT_DIR} ${WOWDECOMP_AARCH64_SYSROOT})
set(ENV{PKG_CONFIG_LIBDIR} "${WOWDECOMP_AARCH64_SYSROOT}/usr/lib/pkgconfig:${WOWDECOMP_AARCH64_SYSROOT}/usr/share/pkgconfig")

set(CMAKE_CROSSCOMPILING_EMULATOR qemu-aarch64-static -L ${WOWDECOMP_AARCH64_SYSROOT})
