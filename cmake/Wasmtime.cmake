# ʕ •ᴥ•ʔ✿ Wasmtime C-API: system install first, pinned prebuilt fallback, statically linked ✿ ʕ •ᴥ•ʔ
option(WOWDECOMP_WASM_ADDONS "Build the WASM addon runtime (requires Wasmtime C API)" ON)
set(WOWDECOMP_WASMTIME_VERSION "36.0.0" CACHE STRING "Pinned Wasmtime release")
set(WASMTIME_FOUND OFF)

if (NOT WOWDECOMP_WASM_ADDONS)
    return()
endif ()

if (NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(WARNING "WasmAddon: no 64-bit Wasmtime C-API build for this target; addons compiled out")
    return()
endif ()

set(_wt_lib "")
set(_wt_include "")
set(_wt_static_define OFF)

find_path(_sys_include NAMES wasmtime.h HINTS ENV WASMTIME_ROOT PATH_SUFFIXES include)
find_library(_sys_lib NAMES wasmtime libwasmtime HINTS ENV WASMTIME_ROOT PATH_SUFFIXES lib)
if (_sys_include AND _sys_lib)
    set(_wt_include ${_sys_include})
    set(_wt_lib ${_sys_lib})
    if (WIN32 AND _sys_lib MATCHES "wasmtime\\.lib$")
        set(_wt_static_define ON)
    endif ()
    message(STATUS "WasmAddon: using system Wasmtime at ${_sys_lib} (version not checked; pinned ${WOWDECOMP_WASMTIME_VERSION} recommended)")
else ()
    if (WIN32 AND MINGW)
        set(_wt_asset "wasmtime-v${WOWDECOMP_WASMTIME_VERSION}-x86_64-mingw-c-api.zip")
        set(_wt_libname "libwasmtime.a")
    elseif (WIN32)
        set(_wt_asset "wasmtime-v${WOWDECOMP_WASMTIME_VERSION}-x86_64-windows-c-api.zip")
        set(_wt_libname "wasmtime.lib")
    elseif (WOWDECOMP_APPLE)
        set(_wt_arches "${CMAKE_OSX_ARCHITECTURES}")
        if (NOT _wt_arches)
            set(_wt_arches "${CMAKE_SYSTEM_PROCESSOR}")
        endif ()
        if (_wt_arches MATCHES "arm64")
            set(_wt_asset "wasmtime-v${WOWDECOMP_WASMTIME_VERSION}-aarch64-macos-c-api.tar.xz")
        elseif (_wt_arches MATCHES "x86_64")
            set(_wt_asset "wasmtime-v${WOWDECOMP_WASMTIME_VERSION}-x86_64-macos-c-api.tar.xz")
        endif ()
        set(_wt_libname "libwasmtime.a")
    elseif (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
        set(_wt_asset "wasmtime-v${WOWDECOMP_WASMTIME_VERSION}-aarch64-linux-c-api.tar.xz")
        set(_wt_libname "libwasmtime.a")
    elseif (CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(_wt_asset "wasmtime-v${WOWDECOMP_WASMTIME_VERSION}-x86_64-linux-c-api.tar.xz")
        set(_wt_libname "libwasmtime.a")
    endif ()
    if (NOT _wt_asset)
        message(WARNING "WasmAddon: no prebuilt Wasmtime asset for this target; addons compiled out")
        return()
    endif ()

    include(FetchContent)
    FetchContent_Declare(wasmtime_capi
        URL "https://github.com/bytecodealliance/wasmtime/releases/download/v${WOWDECOMP_WASMTIME_VERSION}/${_wt_asset}"
        DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    )
    FetchContent_MakeAvailable(wasmtime_capi)
    # ʕ ◕ᴥ◕ ʔ✿ Archives nest a versioned directory; locate headers instead of assuming layout ✿ ʕ ◕ᴥ◕ ʔ
    file(GLOB _wt_roots "${wasmtime_capi_SOURCE_DIR}" "${wasmtime_capi_SOURCE_DIR}/*")
    foreach (_root IN LISTS _wt_roots)
        if (EXISTS "${_root}/include/wasmtime.h" AND EXISTS "${_root}/lib/${_wt_libname}")
            set(_wt_include "${_root}/include")
            set(_wt_lib "${_root}/lib/${_wt_libname}")
        endif ()
    endforeach ()
    if (WIN32 AND NOT MINGW)
        set(_wt_static_define ON)
    endif ()
    if (_wt_lib)
        message(STATUS "WasmAddon: using fetched Wasmtime ${WOWDECOMP_WASMTIME_VERSION} (${_wt_asset}, static)")
    endif ()
endif ()

if (NOT _wt_lib OR NOT EXISTS "${_wt_lib}")
    message(WARNING "WasmAddon: Wasmtime unavailable; addons compiled out")
    return()
endif ()

set(WASMTIME_FOUND ON)
add_library(Wasmtime::Wasmtime STATIC IMPORTED GLOBAL)
set_target_properties(Wasmtime::Wasmtime PROPERTIES
    IMPORTED_LOCATION "${_wt_lib}"
    INTERFACE_INCLUDE_DIRECTORIES "${_wt_include}"
)
if (_wt_static_define)
    target_compile_definitions(Wasmtime::Wasmtime INTERFACE LIBWASM_STATIC=1)
endif ()
if (WIN32)
    target_link_libraries(Wasmtime::Wasmtime INTERFACE ws2_32 advapi32 userenv ntdll shell32 ole32 bcrypt)
elseif (WOWDECOMP_APPLE)
    target_link_libraries(Wasmtime::Wasmtime INTERFACE "-framework CoreFoundation" "-framework Security")
elseif (UNIX)
    target_link_libraries(Wasmtime::Wasmtime INTERFACE dl pthread m)
endif ()
